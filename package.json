{
  "name": "minimi-chat-agent",
  "version": "1.0.0",
  "private": true,
  "description": "A chat agent with web search that remembers what you asked and when.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "seed": "tsx src/seed.ts",
    "test": "tsx --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "chrono-node": "^2.10.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
