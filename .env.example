# Required. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required. Get one at https://app.tavily.com (free tier: 1,000 searches a month)
TAVILY_API_KEY=

# Optional. Any Gemini model with function calling.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. The user's time zone: "today" and "last Tuesday" are read in it.
TIMEZONE=Asia/Kolkata

# Optional.
PORT=3000
DATA_FILE=data/memory.json
